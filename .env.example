# CyberYinYu 配置样例
# 用法：复制本文件为 otowa.env 后填入真实值。
# 注意：config.py 只加载 otowa.env，不会读取 .env 或本文件。
# 本文件只含键名与占位值，禁止写入真实密钥。
#
# 有默认值的可选项默认注释掉：写成 KEY= 的空值会覆盖 config.py 里的默认值。

# ---------- 身份 ----------
BOT_NAME=CyberYinYu
BOT_QQ=1000000000
BOT_NICKNAME=CyberYinYu
# 本实例的最高权限用户（owner）；留空则不启用 owner 确认、用户级权威与 #删除记忆
OWNER_QQ=1000000001

# ---------- 主对话通道 ----------
AI_API_KEY=REPLACE_ME
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_VISION_MODEL=deepseek-flash
# AI_PROXY=
# AI_REQUEST_TIMEOUT_SECONDS=90
# AI_MAX_RETRIES=1

# 兼容旧键（AI_* 为空时回退）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=
# DEEPSEEK_VISION_MODEL=
# DEEPSEEK_PROXY=

# ---------- 视觉通道（留空则沿用 AI_*）----------
# 聊天与看图分成两家的典型配法：聊天走 DeepSeek 官方，看图走网关上的视觉模型。
# VISION_BASE_URL=
# VISION_API_KEY=

# ---------- 百炼联网搜索 ----------
BAILIAN_WEB_SEARCH_ENABLED=true

# ---------- DeepSeek 官方工具通道 ----------
DEEPSEEK_TOOLS_ENABLED=true
# DEEPSEEK_TOOLS_API_KEY=（留空则回退 DEEPSEEK_API_KEY）
DEEPSEEK_TOOLS_BASE_URL=https://api.deepseek.com
DEEPSEEK_TOOLS_MODEL=deepseek-flash
DEEPSEEK_TOOLS_SEARCH_ENABLED=true
DEEPSEEK_TOOLS_FETCH_ENABLED=true
DEEPSEEK_TOOLS_SEARCH_COUNT=8
DEEPSEEK_TOOLS_TIMEOUT_SECONDS=40
DEEPSEEK_TOOLS_HOURLY_LIMIT=0

# ---------- 模型自己打开链接（web_fetch）----------
WEB_FETCH_ENABLED=true
# WEB_FETCH_MAX_BYTES=12582912
# WEB_FETCH_MAX_CHARS=40000
# WEB_FETCH_TIMEOUT_SECONDS=25
# WEB_FETCH_HOURLY_LIMIT=25

# ---------- QQ / NapCat ----------
NAPCAT_API=http://127.0.0.1:3000
NAPCAT_TOKEN=REPLACE_ME
ONEBOT_WS_HOST=127.0.0.1
ONEBOT_WS_PORT=8080
ONEBOT_WS_PATH=/onebot/v11/ws

# ---------- 图搜图（百炼；留空则沿用 AI_*）----------
IMAGE_SEARCH_ENABLED=true
# IMAGE_SEARCH_MODEL=
# IMAGE_SEARCH_BASE_URL=
# IMAGE_SEARCH_API_KEY=
IMAGE_SEARCH_HOURLY_LIMIT=3
IMAGE_SEARCH_MAX_IMAGES=3
IMAGE_SEARCH_TIMEOUT_SECONDS=300
# IMAGE_SEARCH_UNLIMITED_QQ=（留空则沿用 OWNER_QQ）

# ---------- 文生图（#画图）----------
# 需要自己填一个支持 images/generations 的 OpenAI 兼容网关地址；
# 本仓库不附带任何第三方网关默认值。IMAGE_GEN_API_KEY 或 BASE_URL 留空 = 功能关闭。
IMAGE_GEN_ENABLED=true
# IMAGE_GEN_API_KEY=
# IMAGE_GEN_BASE_URL=
# IMAGE_GEN_MODEL=gpt-image-2.5
# IMAGE_GEN_SIZE=1024x1024
# IMAGE_GEN_QUALITY=
# IMAGE_GEN_TIMEOUT_SECONDS=300
IMAGE_GEN_HOURLY_LIMIT=3
IMAGE_GEN_WINDOW_HOURS=2
IMAGE_GEN_DAILY_LIMIT=60
# IMAGE_GEN_UNLIMITED_QQ=（留空则沿用 OWNER_QQ）
# IMAGE_GEN_MAX_PROMPT_CHARS=600

# ---------- 图像编辑（#改图）----------
# IMAGE_EDIT_SIZE=auto
# IMAGE_EDIT_INPUT_FIDELITY=high
# IMAGE_EDIT_MAX_IMAGES=2

# ---------- 提示词润色（#画图 / #改图 共用）----------
IMAGE_PROMPT_POLISH_ENABLED=true
# IMAGE_PROMPT_POLISH_MODEL=（留空则用 AI_MODEL）
# IMAGE_PROMPT_POLISH_BASE_URL=（留空则用 AI_BASE_URL）
# IMAGE_PROMPT_POLISH_API_KEY=（留空则用 AI_API_KEY）
# IMAGE_PROMPT_POLISH_READY_CHARS=80
# IMAGE_PROMPT_POLISH_TIMEOUT_SECONDS=30

# ---------- SauceNAO 以图搜源（#搜源）----------
# 匿名账号不允许调 API：没有 key 时功能等于关闭。
SAUCENAO_ENABLED=true
# SAUCENAO_API_KEY=
# SAUCENAO_API_KEY_FALLBACK=
# SAUCENAO_DB=999
# SAUCENAO_MIN_SIMILARITY=60
# SAUCENAO_MAX_RESULTS=3
# SAUCENAO_TIMEOUT_SECONDS=30
SAUCENAO_HOURLY_LIMIT=6
SAUCENAO_DAILY_LIMIT=90
# SAUCENAO_UNLIMITED_QQ=（留空则沿用 OWNER_QQ）

# ---------- 表情包提取（#表情提取）----------
# STICKER_EXTRACT_MAX_IMAGES=3
# STICKER_EXTRACT_MAX_MB=10

# ---------- 戳一戳 ----------
POKE_REPLY_ENABLED=true
# POKE_REPLY_COOLDOWN_SECONDS=2
# POKE_REPLY_MAX_PER_MINUTE=8

# ---------- 行为与记忆 ----------
QQ_REPLY_WHITELIST_ENABLED=false
QQ_REPLY_WHITELIST=
GROUP_REPLY_ONLY_WHEN_MENTIONED=true
GROUP_REPLY_TO_BOT_AS_MENTION=true
EMPTY_MENTION_REPLY_ENABLED=true
# MEMORY_CONFIRM_QQ=（留空则沿用 OWNER_QQ）
MEMORY_CONFIRM_TTL_SECONDS=1800
CONTEXT_MAX_TURNS=50
CONTEXT_TTL_SECONDS=86400
MAX_IMAGES_PER_MESSAGE=3
VISION_DETAIL=low
THINKING_SMART_MODE=true
THINKING_MIN_CHARS=60
THINKING_FOR_SEARCH=false

# ---------- 并发 ----------
# MAX_CONCURRENT_REPLIES=4
# MAX_PENDING_PER_CONVERSATION=3
# MAX_INFLIGHT_EVENTS=64
# MESSAGE_MAX_AGE_SECONDS=180
# BUSY_NOTICE_COOLDOWN_SECONDS=8

# ---------- 热模式（私聊 18+，默认关闭）----------
# 打开后，私聊主聊天路径会追加 personality/heat.txt 的内容。
# 只在私聊生效，且只有 HEAT_MODE_QQ 里的账号能发命令开启。请先读 SECURITY.md。
HEAT_MODE_ENABLED=false
# HEAT_MODE_QQ=（留空则沿用 OWNER_QQ）
# HEAT_PROMPT_FILE=personality/heat.txt

# ---------- 数据集脚本（仅 dataset/ 下的清洗脚本读取）----------
# CYBERYINYU_TARGETS=1000000001=示例名,1000000002=第二个账号
# CYBERYINYU_BOT_QQ=1000000000
# CYBERYINYU_BOT_NAME=CyberYinYu
# FEWSHOT_INDEX=dataset/cleaned/ctx_pairs.jsonl
