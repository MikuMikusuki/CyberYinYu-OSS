# CyberYinYu 配置样例
# 用法：复制本文件为 otowa.env 后填入真实值。
# 注意：config.py 只加载 otowa.env，不会读取 .env 或本文件。
# 本文件只含键名与占位值，禁止写入真实密钥。
#
# 有默认值的可选项默认注释掉：写成 KEY= 的空值会覆盖 config.py 里的默认值。

# ---------- 身份 ----------
BOT_NAME=CyberYinYu
BOT_QQ=1000000000
BOT_NICKNAME=CyberYinYu
# 本实例的最高权限用户；留空则不启用 owner 确认与 #删除记忆
OWNER_QQ=1000000001

# ---------- 主对话通道 ----------
AI_API_KEY=REPLACE_ME
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_VISION_MODEL=deepseek-flash
# AI_PROXY=

# 兼容旧键（AI_* 为空时回退）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=
# DEEPSEEK_VISION_MODEL=
# DEEPSEEK_PROXY=

# ---------- 百炼联网搜索 ----------
BAILIAN_WEB_SEARCH_ENABLED=true

# ---------- DeepSeek 官方工具通道 ----------
DEEPSEEK_TOOLS_ENABLED=true
# DEEPSEEK_TOOLS_API_KEY=（留空则回退 DEEPSEEK_API_KEY）
DEEPSEEK_TOOLS_BASE_URL=https://api.deepseek.com
DEEPSEEK_TOOLS_MODEL=deepseek-flash
DEEPSEEK_TOOLS_SEARCH_ENABLED=true
DEEPSEEK_TOOLS_FETCH_ENABLED=true
DEEPSEEK_TOOLS_SEARCH_COUNT=8
DEEPSEEK_TOOLS_TIMEOUT_SECONDS=40
DEEPSEEK_TOOLS_HOURLY_LIMIT=0

# ---------- QQ / NapCat ----------
NAPCAT_API=http://127.0.0.1:3000
NAPCAT_TOKEN=REPLACE_ME
ONEBOT_WS_HOST=127.0.0.1
ONEBOT_WS_PORT=8080
ONEBOT_WS_PATH=/onebot/v11/ws

# ---------- 图搜图（百炼；留空则沿用 AI_*） ----------
IMAGE_SEARCH_ENABLED=true
# IMAGE_SEARCH_MODEL=
# IMAGE_SEARCH_BASE_URL=
# IMAGE_SEARCH_API_KEY=
IMAGE_SEARCH_HOURLY_LIMIT=3
IMAGE_SEARCH_MAX_IMAGES=3
IMAGE_SEARCH_TIMEOUT_SECONDS=300
# IMAGE_SEARCH_UNLIMITED_QQ=（留空则沿用 OWNER_QQ）

# ---------- 行为与记忆 ----------
QQ_REPLY_WHITELIST_ENABLED=false
QQ_REPLY_WHITELIST=
GROUP_REPLY_ONLY_WHEN_MENTIONED=true
EMPTY_MENTION_REPLY_ENABLED=true
# MEMORY_CONFIRM_QQ=（留空则沿用 OWNER_QQ）
MEMORY_CONFIRM_TTL_SECONDS=1800
CONTEXT_MAX_TURNS=50
CONTEXT_TTL_SECONDS=86400
MAX_IMAGES_PER_MESSAGE=3
VISION_DETAIL=low
THINKING_SMART_MODE=true
THINKING_MIN_CHARS=15
THINKING_FOR_SEARCH=false
