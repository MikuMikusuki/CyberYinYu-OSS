[Unit]
Description=CyberYinYu QQ bot (NapCat OneBot 11 reverse WebSocket)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/python __APP_DIR__/bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
StandardOutput=append:__APP_DIR__/logs/bot-console.log
StandardError=append:__APP_DIR__/logs/bot-console-error.log

[Install]
WantedBy=multi-user.target
